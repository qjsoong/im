# Rust build artifacts
/target/
**/*.rs.bk

# Lock files of workspace members are tracked; ignore stray locks elsewhere
crates/*/Cargo.lock
xtask/Cargo.lock
!Cargo.lock

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Throwaway output from data-generation runs
/tools/out/
*.tmp.tsv
